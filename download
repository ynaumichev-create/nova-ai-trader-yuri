
name: NOVA Autonomous Paper Trading

on:
  schedule:
    - cron: "*/30 * * * *"
  workflow_dispatch:

permissions:
  contents: write

jobs:
  trade:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - run: pip install -r requirements.txt

      - name: Run NOVA
        env:
          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
        run: python worker.py

      - name: Save results
        run: |
          git config user.name "nova-paper-bot"
          git config user.email "nova-paper-bot@users.noreply.github.com"
          git add data/
          git diff --cached --quiet || git commit -m "NOVA paper trading update"
          git push
